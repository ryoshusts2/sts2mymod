<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project=".\local.props" Condition="Exists('.\local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>MyFirstMod</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

        <GodotExportPreset>Windows Desktop</GodotExportPreset>
        <!-- 强制指向项目根目录 -->
        <Sts2DataDir>$(MSBuildProjectDirectory)</Sts2DataDir>
        <ModOutputDir>$(Sts2DataDir)\mods\$(MSBuildProjectName)\</ModOutputDir>
        <ModPckPath>$(ModOutputDir)$(MSBuildProjectName).pck</ModPckPath>
        <RitsuLibDeployDir Condition="'$(RitsuLibDeployDir)' == ''">$(Sts2DataDir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
        <RunPckExport Condition="'$(RunPckExport)' == '' and '$(DesignTimeBuild)' != 'true'">true</RunPckExport>
        <RunPckExport Condition="'$(RunPckExport)' == ''">false</RunPckExport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all"/>
        <PackageReference Include="STS2.RitsuLib" Version="*" GeneratePathProperty="true"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True"/>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True"/>
    </ItemGroup>

    <!-- 终极保险：强制指定路径，公开化所有虚拟和编译器生成成员，彻底解决找不到定义的问题 -->
    <ItemGroup>
        <Publicize Include="sts2" Path="$(Sts2DataDir)\sts2.dll" IncludeVirtualMembers="true" IncludeCompilerGeneratedMembers="true" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <AdditionalFiles Include="MyFirstMod/localization/**/*.json"/>
        <Compile Remove="MyFirstMod/**"/>
        <EmbeddedResource Remove="MyFirstMod/**"/>
        <None Include="MyFirstMod/**"/>
        <None Include="MyFirstMod.json"/>
        <None Include="project.godot"/>
        <None Include="export_presets.cfg"/>
        <None Include=".gitignore"/>
        <None Include="local.props.template"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="local.props" Condition="Exists('local.props')"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="MyFirstMod\images\cards\"/>
        <Folder Include="MyFirstMod\images\characters\"/>
        <Folder Include="MyFirstMod\images\relics\"/>
        <Folder Include="MyFirstMod\scenes\characters\"/>
    </ItemGroup>
</Project>