<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>MyFirstMod</RootNamespace>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>
        <CopyModOnBuild>false</CopyModOnBuild>
        <RunPckExport>false</RunPckExport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="*" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony"><HintPath>0Harmony.dll</HintPath><Private>True</Private></Reference>
        <Reference Include="sts2"><HintPath>sts2.dll</HintPath><Private>True</Private></Reference>
        <Reference Include="Steamworks.NET"><HintPath>Steamworks.NET.dll</HintPath><Private>True</Private></Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**" />
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**" />
        <None Include="MyFirstMod.json" />
        <None Include="project.godot" />
        <None Include="export_presets.cfg" />
        <None Include=".gitignore" />
    </ItemGroup>
</Project>