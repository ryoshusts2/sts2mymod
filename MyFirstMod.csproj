<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>MyFirstMod</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

        <GodotExportPreset>Windows Desktop</GodotExportPreset>
        <!-- 强制写死数据目录，不做任何复杂判断 -->
        <Sts2DataDir>$(MSBuildProjectDirectory)</Sts2DataDir>
        <ModOutputDir>$(Sts2DataDir)\mods\$(MSBuildProjectName)\</ModOutputDir>
        <ModPckPath>$(ModOutputDir)$(MSBuildProjectName).pck</ModPckPath>
        <RitsuLibDeployDir>$(Sts2DataDir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
        <CopyModOnBuild>true</CopyModOnBuild>
        <RunPckExport>false</RunPckExport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all"/>
        <PackageReference Include="STS2.RitsuLib" Version="*" GeneratePathProperty="true"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 核心改动：直接使用相对路径，因为文件全在同一个目录里，绝对能找到！ -->
        <Reference Include="0Harmony" HintPath="0Harmony.dll" Private="True"/>
        <Reference Include="sts2" HintPath="sts2.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="Steamworks.NET.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 标准公开化写法，自动解析上面配置的引用路径 -->
        <Publicize Include="sts2" IncludeVirtualMembers="true" IncludeCompilerGeneratedMembers="true" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>

        <Compile Remove="MyFirstMod/**"/>
        <EmbeddedResource Remove="MyFirstMod/**"/>
        <None Include="MyFirstMod/**"/>
        <None Include="MyFirstMod.json"/>
        <None Include="project.godot"/>
        <None Include="export_presets.cfg"/>
        <None Include=".gitignore"/>
        <None Include="local.props.template"/>
    </ItemGroup>
</Project>